<!-- 核销工作台 -->
<view class="container">
  <!-- 顶部品牌区 -->
  <view class="header-bar">
    <text class="header-title">核销工作台</text>
  </view>

  <!-- 统计数据 -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-label">今日核销</text>
      <text class="stat-number gold">{{stats.todayVerified}}</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-card">
      <text class="stat-label">累计核销</text>
      <text class="stat-number red">{{stats.totalVerified}}</text>
    </view>
  </view>

  <!-- 扫一扫核销按钮 -->
  <view class="scan-section">
    <view class="scan-btn" bindtap="goScan">
      <text class="scan-btn-icon">📷</text>
      <text class="scan-btn-text">扫一扫核销</text>
    </view>
  </view>

  <!-- 最近核销记录 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">最近核销</text>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading-state">
      <text>加载中...</text>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{recentRecords.length === 0}}" class="empty-state">
      <text>暂无核销记录</text>
    </view>

    <!-- 记录列表 -->
    <view wx:else class="record-list">
      <view
        class="record-item"
        wx:for="{{recentRecords}}"
        wx:key="id"
      >
        <view class="record-info">
          <text class="record-no">{{item.reservationNo || '—'}}</text>
          <text class="record-detail">{{item.visitDate || '—'}} · {{item.type === 'TEAM' ? '团队' : '个人'}} · {{item.visitorCount || 1}}人<text wx:if="{{item.type === 'PERSONAL' && item.actualCount > 0}}"> · 实到{{item.actualCount}}人</text></text>
          <text class="record-time">{{formatTime(item.verifiedAt || item.createdAt)}}</text>
        </view>
        <view class="record-badge verified">
          <text>已核销</text>
        </view>
      </view>
    </view>

    <!-- 查看全部 -->
    <view wx:if="{{recentRecords.length > 0}}" class="view-all" bindtap="goRecords">
      <text>查看全部记录 ›</text>
    </view>
  </view>
</view>
