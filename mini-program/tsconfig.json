{
  "compilerOptions": {
    "target": "ES2015",
    "module": "commonjs",
    "sourceMap": false,
    "strict": false,
    "esModuleInterop": true,
    "noEmitOnError": false,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "allowSyntheticDefaultImports": true,
    "lib": ["es2017"],
    "types": ["wechat-miniprogram"],
    "outDir": ".",
    "rootDir": "."
  },
  "include": [
    "pages/**/*.ts",
    "pages-verifier/**/*.ts",
    "custom-tab-bar/**/*.ts",
    "utils/**/*.ts",
    "app.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
