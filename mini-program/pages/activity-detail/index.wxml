<!-- 活动详情 -->
<view class="container">
  <!-- 封面图 -->
  <view class="cover-wrap" wx:if="{{activity}}">
    <image class="cover-img" src="{{activity.coverImage}}" mode="widthFix" />
  </view>

  <!-- 详情内容 -->
  <view class="content-wrap" wx:if="{{!loading && activity}}">
    <!-- 标题 + 状态标签 -->
    <view class="header">
      <text class="title">{{activity.title}}</text>
      <text class="status-badge {{activity.status === 'ongoing' ? 'badge-ongoing' : 'badge-ended'}}">
        {{activity.status === 'ongoing' ? '进行中' : '已结束'}}
      </text>
    </view>

    <!-- 时间地点 -->
    <view class="meta">
      <text class="meta-item">时间：{{activity._startTime}} - {{activity._endTime}}</text>
      <text class="meta-item">地点：{{activity.location}}</text>
    </view>

    <!-- 富文本内容 -->
    <rich-text class="rich-content" nodes="{{activity.richContent}}"></rich-text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 返回按钮 -->
  <view class="back-btn-wrap" wx:if="{{!loading}}">
    <button class="btn-primary" bindtap="goBack">返回</button>
  </view>
</view>
