<view class="container">
  <view class="page-title">意见反馈</view>

  <!-- 联系方式 -->
  <view class="form-section">
    <text class="section-label">联系方式（选填）</text>
    <input
      class="form-input"
      placeholder="请留下手机号或微信号，方便我们联系您"
      value="{{contact}}"
      bindinput="onContactInput"
      maxlength="64"
    />
  </view>

  <!-- 反馈内容 -->
  <view class="form-section">
    <textarea
      class="content-textarea"
      placeholder="请描述您的意见或遇到的问题，我们会尽快处理..."
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="500"
      auto-height
    />
    <text class="word-count">{{content.length}}/500</text>
  </view>

  <!-- 图片上传 -->
  <view class="form-section">
    <view class="upload-label">
      <text>截图上传（选填）</text>
      <text class="upload-tip">最多9张</text>
    </view>

    <view class="upload-grid">
      <view
        class="upload-item image-preview"
        wx:for="{{images}}"
        wx:key="*this"
        wx:for-index="index"
      >
        <image
          class="preview-img"
          src="{{item}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="previewImage"
        />
        <view
          class="remove-img"
          data-index="{{index}}"
          catchtap="removeImage"
        >
          <text>✕</text>
        </view>
      </view>

      <!-- 添加按钮 -->
      <view
        wx:if="{{images.length < 9}}"
        class="upload-item add-btn"
        bindtap="chooseImage"
      >
        <text class="add-icon">+</text>
        <text class="add-text">上传</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <button
    class="submit-btn"
    loading="{{submitting}}"
    disabled="{{submitting}}"
    bindtap="submit"
  >
    {{submitting ? '提交中...' : '提交反馈'}}
  </button>
</view>
