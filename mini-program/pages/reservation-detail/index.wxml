<view class="container">
  <!-- 加载中 -->
  <view class="loading-tip" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 详情内容 -->
  <view class="detail-content" wx:if="{{!loading && reservation}}">
    <!-- 状态横幅 -->
    <view class="status-banner status-{{reservation.status}}">
      <view class="status-icon">
        <text wx:if="{{reservation.status === 'APPROVING' || reservation.status === 'PENDING'}}">📋</text>
        <text wx:if="{{reservation.status === 'APPROVED'}}">✅</text>
        <text wx:if="{{reservation.status === 'VERIFIED'}}">✔</text>
        <text wx:if="{{reservation.status === 'CANCELLED'}}">✕</text>
        <text wx:if="{{reservation.status === 'REJECTED'}}">!</text>
      </view>
      <view class="status-info">
        <text class="status-title">{{reservation.statusLabel}}</text>
        <text class="status-desc" wx:if="{{reservation.status === 'PENDING'}}">请出示核销码完成检票入场</text>
        <text class="status-desc" wx:if="{{reservation.status === 'APPROVING'}}">团队预约需管理员审核，请耐心等待</text>
        <text class="status-desc" wx:if="{{reservation.status === 'APPROVED'}}">请在参观时出示核销码完成检票</text>
        <text class="status-desc" wx:if="{{reservation.status === 'VERIFIED'}}">感谢您参观椰树集团，欢迎下次光临</text>
        <text class="status-desc" wx:if="{{reservation.status === 'CANCELLED'}}">该预约已被取消</text>
        <text class="status-desc status-reject" wx:if="{{reservation.status === 'REJECTED'}}">
          拒绝原因：{{reservation.rejectReason || '未通过审核'}}
        </text>
      </view>
    </view>

    <!-- 预约信息卡片 -->
    <view class="card">
      <view class="card-title">预约信息</view>
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">预约单号</text>
          <text class="info-value selectable">{{reservation.reservationNo}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">参观日期</text>
          <text class="info-value">{{reservation.date}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">参观场次</text>
          <text class="info-value">{{reservation.sessionLabel}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">预约类型</text>
          <text class="info-value">{{reservation.typeLabel}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">参观人数</text>
          <text class="info-value">{{reservation.visitorCount}} 人</text>
        </view>
      </view>
    </view>

    <!-- 团队信息 -->
    <view class="card" wx:if="{{reservation.teamInfo}}">
      <view class="card-title">团队信息</view>
      <view class="info-grid">
        <view class="info-item">
          <text class="info-label">联系人</text>
          <text class="info-value">{{reservation.teamInfo.contactName}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">联系电话</text>
          <text class="info-value">{{reservation.teamInfo.contactPhone}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">团队类型</text>
          <text class="info-value">{{reservation.teamInfo.teamTypeLabel}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">单位名称</text>
          <text class="info-value">{{reservation.teamInfo.orgName}}</text>
        </view>
        <view class="info-item" wx:if="{{reservation.teamInfo.orgCode}}">
          <text class="info-label">信用代码</text>
          <text class="info-value">{{reservation.teamInfo.orgCode}}</text>
        </view>
      </view>
    </view>

    <!-- 参观人列表 -->
    <view class="card" wx:if="{{reservation.visitors && reservation.visitors.length > 0}}">
      <view class="card-title">参观人信息</view>
      <view
        class="visitor-item"
        wx:for="{{reservation.visitors}}"
        wx:key="id"
        wx:for-index="vIndex"
      >
        <text class="visitor-index">#{{vIndex + 1}}</text>
        <view class="visitor-info">
          <text class="visitor-name">{{item.name}}</text>
          <text class="visitor-idcard">{{item.idCard}}</text>
          <text class="visitor-address">{{item.province}} {{item.city}}</text>
        </view>
      </view>
    </view>

    <!-- QR码核销 -->
    <view class="card qr-card" wx:if="{{showQrCode}}">
      <view class="card-title">核销二维码</view>
      <view class="qr-container">
        <image
          class="qr-image"
          src="{{qrCodeImage || reservation.qrCodeUrl}}"
          mode="widthFix"
        />
      </view>
      <text class="qr-hint">请在入口处出示此码完成检票</text>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <button
        class="btn-cancel"
        wx:if="{{canCancel}}"
        bindtap="cancelReservation"
      >取消预约</button>
      <button
        class="btn-outline"
        bindtap="goBack"
      >返回列表</button>
    </view>
  </view>

  <!-- 取消预约弹窗 -->
  <view class="cancel-sheet-mask" wx:if="{{showCancelSheet}}" bindtap="hideCancelSheet"></view>
  <view class="cancel-sheet" wx:if="{{showCancelSheet}}">
    <view class="cancel-sheet-header">
      <text class="cancel-sheet-title">取消预约</text>
      <text class="cancel-sheet-close" bindtap="hideCancelSheet">✕</text>
    </view>
    <view class="cancel-sheet-body">
      <text class="cancel-sheet-label">请选择取消原因</text>
      <view class="cancel-reason-tags">
        <view
          class="cancel-tag {{cancelReason === item ? 'active' : ''}}"
          wx:for="{{cancelReasonTags}}"
          wx:key="*this"
          data-reason="{{item}}"
          bindtap="selectCancelReason"
        >{{item}}</view>
      </view>
      <input
        class="cancel-reason-input"
        placeholder="或输入其他原因（选填）"
        value="{{cancelReason}}"
        bindinput="onCancelReasonInput"
        maxlength="100"
      />
    </view>
    <view class="cancel-sheet-footer">
      <button class="cancel-sheet-btn cancel-confirm-btn" bindtap="confirmCancel">确认取消</button>
    </view>
  </view>

  <!-- 加载失败 -->
  <view class="empty-state" wx:if="{{!loading && !reservation}}">
    <text class="empty-text">未找到预约信息</text>
    <view class="empty-action" bindtap="goBack">返回</view>
  </view>
</view>
