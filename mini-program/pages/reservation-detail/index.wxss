@charset "UTF-8";
/* 预约详情 - 品牌风格 */
.container {
  min-height: 100vh;
  padding-bottom: 40px;
}

.detail-content {
  padding: 0 16px;
}

/* ===== 状态横幅 ===== */
.status-banner {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 16px;
  margin: 12px 0;
  border-radius: 12px;
}
.status-banner.status-approving {
  background: #fff8e1;
}
.status-banner.status-approved {
  background: #e8f5e9;
}
.status-banner.status-verified {
  background: #e3f2fd;
}
.status-banner.status-cancelled {
  background: #f5f5f5;
}
.status-banner.status-rejected {
  background: #ffebee;
}

.status-icon {
  font-size: 28px;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.status-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.status-title {
  font-size: 16px;
  font-weight: bold;
  color: #000000;
}

.status-desc {
  font-size: 12px;
  color: #666;
  line-height: 1.5;
}
.status-desc.status-reject {
  color: #e60012;
}

/* ===== 卡片通用 ===== */
.card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 15px;
  font-weight: bold;
  color: #000000;
  margin-bottom: 14px;
  padding-bottom: 10px;
  border-bottom: 2px solid #ffd700;
}

/* ===== 信息网格 ===== */
.info-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 13px;
  color: #999;
}

.info-value {
  font-size: 13px;
  color: #000000;
  font-weight: 500;
}
.info-value.selectable {
  user-select: text;
}

/* ===== 参观人列表 ===== */
.visitor-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid #f5f5f5;
}
.visitor-item:last-child {
  border-bottom: none;
}

.visitor-index {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: #ffd700;
  color: #000000;
  font-size: 12px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2px;
}

.visitor-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.visitor-name {
  font-size: 14px;
  font-weight: bold;
  color: #000000;
}

.visitor-idcard {
  font-size: 12px;
  color: #666;
}

.visitor-address {
  font-size: 12px;
  color: #999;
}

/* ===== QR码 ===== */
.qr-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-container {
  width: 200px;
  height: 200px;
  margin: 12px auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-image {
  width: 200px;
  height: 200px;
}

.qr-placeholder {
  width: 200px;
  height: 200px;
  background: #f5f5f5;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2px dashed #ddd;
}

.qr-placeholder-icon {
  font-size: 48px;
  color: #ccc;
  margin-bottom: 8px;
}

.qr-placeholder-text {
  font-size: 14px;
  color: #999;
  text-align: center;
  word-break: break-all;
}

.qr-hint {
  font-size: 12px;
  color: #999;
  text-align: center;
  margin-top: 4px;
}

/* ===== 操作按钮 ===== */
.action-bar {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 20px;
  padding-bottom: 20px;
}

.btn-cancel {
  width: 100%;
  height: 44px;
  border: 1px solid #ddd;
  border-radius: 8px;
  color: #999;
  font-size: 15px;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-cancel::after {
  border: none;
}
.btn-cancel:active {
  background: #f5f5f5;
}

.btn-outline {
  width: 100%;
  height: 44px;
  border: 1px solid #e60012;
  border-radius: 8px;
  color: #e60012;
  font-size: 15px;
  font-weight: bold;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-outline::after {
  border: none;
}
.btn-outline:active {
  background: #fff5f5;
}

/* ===== 加载/空状态 ===== */
.loading-tip {
  text-align: center;
  padding: 80px 0;
  font-size: 14px;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80px 16px;
  gap: 16px;
}

.empty-text {
  font-size: 16px;
  color: #999;
}

.empty-action {
  padding: 8px 28px;
  border: 1px solid #e60012;
  border-radius: 20px;
  font-size: 14px;
  color: #e60012;
}
.empty-action:active {
  background: #fff5f5;
}
