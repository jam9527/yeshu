<view class="container">
  <!-- 加载中 -->
  <view class="loading-tip" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 有待核销预约 -->
  <view class="qr-page" wx:if="{{!loading && reservation && (reservation.status === 'APPROVED' || reservation.status === 'PENDING')}}">
    <!-- 品牌标题 -->
    <view class="brand-header">
      <text class="brand-name">椰树集团</text>
      <text class="brand-subtitle">参观核销码</text>
    </view>

    <!-- QR码区域 -->
    <view class="qr-card">
      <image
        class="qr-image"
        src="{{reservation.qrCodeUrl || reservation.qrCode}}"
        mode="widthFix"
        wx:if="{{reservation.qrCodeUrl || reservation.qrCode}}"
      />
      <view class="qr-fallback" wx:else>
        <view class="qr-fallback-grid">
          <view class="fb-cell" wx:for="{{32}}" wx:key="this"></view>
        </view>
        <text class="qr-fallback-text">{{reservation.reservationNo}}</text>
      </view>
    </view>

    <!-- 预约简要信息 -->
    <view class="reservation-info">
      <text class="info-no">预约单号：{{reservation.reservationNo}}</text>
      <text class="info-detail">{{reservation.date}} · {{reservation.sessionLabel}}</text>
      <text class="info-detail">{{reservation.typeLabel}} · {{reservation.visitorCount}}人</text>
    </view>

    <!-- 倒计时/刷新 -->
    <view class="refresh-bar">
      <text class="refresh-countdown" wx:if="{{countdown > 0}}">{{countdown}}秒后自动刷新</text>
      <view class="refresh-btn" bindtap="refresh">
        <text>刷新核销码</text>
      </view>
    </view>

    <!-- 提示 -->
    <view class="hint-text">
      <text>请在入口处出示此码，由工作人员扫码核销</text>
    </view>
  </view>

  <!-- 有待审核预约 -->
  <view class="qr-page" wx:if="{{!loading && reservation && reservation.status === 'APPROVING'}}">
    <view class="empty-approving">
      <view class="empty-icon">⏳</view>
      <text class="empty-title">预约审核中</text>
      <text class="empty-desc">您的团队预约正在等待管理员审核</text>
      <view class="reservation-info" style="margin-top: 16px;">
        <text class="info-no">预约单号：{{reservation.reservationNo}}</text>
        <text class="info-detail">{{reservation.date}} · {{reservation.sessionLabel}}</text>
      </view>
      <view class="refresh-btn" bindtap="refresh" style="margin-top: 20px;">
        <text>刷新状态</text>
      </view>
    </view>
  </view>

  <!-- 无可用核销码 -->
  <view class="empty-state" wx:if="{{!loading && !reservation}}">
    <view class="empty-icon">🎫</view>
    <text class="empty-title">暂无可用核销码</text>
    <text class="empty-desc">您目前没有待核销的预约</text>
    <view class="action-group">
      <view class="action-btn primary" bindtap="goPersonalReservation">
        立即预约
      </view>
      <view class="action-btn outline" bindtap="goMyReservations">
        查看我的预约
      </view>
    </view>
  </view>
</view>
