<view class="login-container">
  <view class="login-box">
    <image class="logo" src="/assets/images/logo.png" mode="widthFix" />
    <text class="title">椰树集团</text>
    <text class="subtitle">参观预约</text>

    <!-- 步骤1：手机号登录 -->
    <block wx:if="{{!phoneLoggedIn && !codeLoggedIn}}">
      <button class="login-btn" open-type="getPhoneNumber|agreePrivacyAuthorization" bindgetphonenumber="handlePhoneLogin" bindagreeprivacyauthorization="handleAgreePrivacy">
        微信一键登录
      </button>

      <view class="test-login-section">
        <view class="divider"><text>测试环境（开发用）</text></view>
        <input class="nickname-input" placeholder="输入测试用户名（区分不同用户）" maxlength="20" bindinput="onTestUsernameInput" value="{{testUsername}}" />
        <button class="test-login-btn" bindtap="handleTestLogin">
          测试登录
        </button>
      </view>

      <text class="tip">登录即表示同意《用户协议及隐私政策》</text>
    </block>

    <!-- 步骤1完成 → 静默获取昵称中 -->
    <block wx:elif="{{(phoneLoggedIn || codeLoggedIn) && fetchingNickname}}">
      <text class="step-title">登录成功</text>
      <text class="step-desc">正在获取您的昵称...</text>
      <view class="loading-spinner"></view>
    </block>

    <!-- 步骤2：设置个人信息（首次登录时） -->
    <block wx:elif="{{needNicknameAuth}}">
      <text class="step-title">设置个人信息</text>
      <text class="step-desc">方便管理员识别您的身份</text>

      <button class="avatar-pick-btn" open-type="chooseAvatar" bindchooseavatar="handleChooseAvatar">
        选择微信头像
      </button>
      <image wx:if="{{chosenAvatarUrl}}" class="preview-avatar" src="{{chosenAvatarUrl}}" mode="aspectFill" />

      <view class="divider"><text>选择微信昵称</text></view>
      <input class="nickname-input" type="nickname" placeholder="点击获取微信昵称" maxlength="32" bindinput="onNicknameInput" value="{{nicknameInput}}" />

      <button class="login-btn" bindtap="handleSaveNickname" loading="{{saving}}">
        保存并进入
      </button>

      <button class="skip-btn" bindtap="handleSkipNickname">暂不设置</button>
    </block>
  </view>
</view>
