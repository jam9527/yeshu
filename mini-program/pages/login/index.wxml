<view class="login-container" style="background-image: url({{pageConfig.background}})">
  <view class="login-box">
    <!-- Logo：优先使用后台配置，否则使用默认 -->
    <image wx:if="{{pageConfig.logo}}" class="logo" src="{{pageConfig.logo}}" mode="widthFix" />
    <image wx:else class="logo" src="/assets/images/logo.png" mode="widthFix" />
    <!-- 标题文字：仅无自定义 logo 时显示 -->
    <text wx:if="{{!pageConfig.logo}}" class="title" style="color: {{pageConfig.titleColor}}">椰树集团</text>
    <text wx:if="{{!pageConfig.logo}}" class="subtitle" style="color: {{pageConfig.titleColor}}">参观预约</text>

    <!-- 步骤1：手机号登录 -->
    <block wx:if="{{!phoneLoggedIn && !codeLoggedIn}}">
      <!-- 未勾选协议：显示灰色禁用按钮 -->
      <view wx:if="{{!agreedToPrivacy}}" class="login-btn login-btn-disabled">
        手机号授权登录
      </view>
      <!-- 已勾选协议：显示真实登录按钮 -->
      <button
        wx:else
        class="login-btn"
        style="background: {{pageConfig.buttonColor}}; color: {{pageConfig.buttonTextColor}}"
        open-type="getPhoneNumber|agreePrivacyAuthorization"
        bindgetphonenumber="handlePhoneLogin"
        bindagreeprivacyauthorization="handleAgreePrivacy"
      >
        手机号授权登录
      </button>

      <!-- 隐私协议勾选区域 -->
      <view class="agreement" bindtap="handleAgreementTap">
        <view class="agreement-checkbox {{agreedToPrivacy ? 'checked' : ''}}">
          <text wx:if="{{agreedToPrivacy}}">✓</text>
        </view>
        <text class="agreement-text">我已阅读并同意</text>
        <text data-action="openTerms" class="agreement-link">《用户协议》</text>
        <text class="agreement-text">及</text>
        <text data-action="openPrivacyPolicy" class="agreement-link">《隐私政策》</text>
      </view>
    </block>

    <!-- 步骤1完成 → 静默获取昵称中 -->
    <block wx:elif="{{(phoneLoggedIn || codeLoggedIn) && fetchingNickname}}">
      <text class="step-title">登录成功</text>
      <text class="step-desc">正在获取您的昵称...</text>
      <view class="loading-spinner"></view>
    </block>

    <!-- 步骤2：设置个人信息（首次登录时） -->
    <block wx:elif="{{needNicknameAuth}}">
      <text class="step-title">设置个人信息</text>
      <text class="step-desc">方便管理员识别您的身份</text>

      <button class="avatar-pick-btn" open-type="chooseAvatar" bindchooseavatar="handleChooseAvatar">
        选择微信头像
      </button>
      <image wx:if="{{chosenAvatarUrl}}" class="preview-avatar" src="{{chosenAvatarUrl}}" mode="aspectFill" />

      <view class="divider"><text>选择微信昵称</text></view>
      <input class="nickname-input" type="nickname" placeholder="点击获取微信昵称" maxlength="32" bindinput="onNicknameInput" value="{{nicknameInput}}" />

      <button
        class="login-btn"
        style="background: {{pageConfig.buttonColor}}; color: {{pageConfig.buttonTextColor}}"
        bindtap="handleSaveNickname"
        loading="{{saving}}"
      >
        保存并进入
      </button>

      <button class="skip-btn" bindtap="handleSkipNickname">暂不设置</button>
    </block>
  </view>
</view>
