<view class="login-container">
  <view class="login-box">
    <image class="logo" src="/assets/images/logo.png" mode="widthFix" />
    <text class="title">椰树集团</text>
    <text class="subtitle">参观预约</text>

    <!-- 步骤1：手机号登录 -->
    <block wx:if="{{!phoneLoggedIn && !codeLoggedIn}}">
      <button class="login-btn" open-type="getPhoneNumber" bindgetphonenumber="handlePhoneLogin">
        微信一键登录
      </button>
      <button class="test-login-btn" bindtap="handleTestLogin">
        测试登录（开发用）
      </button>
      <text class="tip">登录即表示同意《用户协议及隐私政策》</text>
    </block>

    <!-- 步骤1完成 → 静默获取昵称中 -->
    <block wx:elif="{{(phoneLoggedIn || codeLoggedIn) && fetchingNickname}}">
      <text class="step-title">登录成功</text>
      <text class="step-desc">正在获取您的昵称...</text>
      <view class="loading-spinner"></view>
    </block>

    <!-- 步骤2：设置昵称 -->
    <block wx:elif="{{needNicknameAuth}}">
      <text class="step-title">设置昵称</text>
      <text class="step-desc">授权微信昵称或手动输入，方便管理员识别</text>

      <button class="login-btn" open-type="getUserInfo" bindgetuserinfo="handleGetUserInfo">
        获取微信昵称
      </button>

      <view class="divider"><text>或</text></view>

      <input class="nickname-input" placeholder="输入你的昵称" maxlength="20" bindinput="onNicknameInput" />
      <button class="login-btn" bindtap="handleSaveNickname" loading="{{saving}}">
        保存昵称
      </button>

      <button class="skip-btn" bindtap="handleSkipNickname">暂不设置</button>
    </block>
  </view>
</view>
