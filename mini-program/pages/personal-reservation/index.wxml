<view class="container">
  <!-- ===== 预约须知弹窗（带5s倒计时） ===== -->
  <view class="notice-mask" wx:if="{{showNotice}}"></view>
  <view class="notice-popup" wx:if="{{showNotice}}">
    <view class="notice-popup-header">
      <text class="notice-popup-title">预约须知</text>
    </view>
    <scroll-view class="notice-popup-body" scroll-y>
      <rich-text nodes="{{noticeContent}}"></rich-text>
    </scroll-view>
    <view class="notice-popup-footer">
      <button
        class="btn-primary notice-btn {{countdown > 0 ? 'disabled' : ''}}"
        disabled="{{countdown > 0}}"
        bindtap="agreeNotice"
      >{{countdown > 0 ? '请仔细阅读（' + countdown + 's）' : '我已阅读并同意'}}</button>
    </view>
  </view>

  <view wx:if="{{agreed}}">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title-main">个人预约</text>
    <text class="page-title-sub">预约人须完成实名认证，每次最多预约5人</text>
  </view>

  <!-- ===== 步骤指示器 ===== -->
  <view class="step-indicator">
    <view class="step-item {{currentStep >= 1 ? 'active' : ''}}">
      <view class="step-circle {{currentStep >= 1 ? 'active' : ''}}">1</view>
      <text class="step-label">选择日期</text>
    </view>
    <view class="step-line {{currentStep >= 2 ? 'active' : ''}}"></view>
    <view class="step-item {{currentStep >= 2 ? 'active' : ''}}">
      <view class="step-circle {{currentStep >= 2 ? 'active' : ''}}">2</view>
      <text class="step-label">选择场次</text>
    </view>
    <view class="step-line {{currentStep >= 3 ? 'active' : ''}}"></view>
    <view class="step-item {{currentStep >= 3 ? 'active' : ''}}">
      <view class="step-circle {{currentStep >= 3 ? 'active' : ''}}">3</view>
      <text class="step-label">填写信息</text>
    </view>
  </view>

  <!-- ===== 步骤 1: 选择日期（日历视图） ===== -->
  <view class="step-content" wx:if="{{currentStep === 1}}">
    <view class="section-title">选择参观日期</view>

    <view class="loading-tip" wx:if="{{loading}}">加载中...</view>

    <view class="calendar-card" wx:if="{{!loading}}">
      <!-- 月份标题 + 导航 -->
      <view class="calendar-header">
        <view class="calendar-nav" bindtap="prevMonth">‹</view>
        <text class="calendar-month">{{currentMonthLabel}}</text>
        <view class="calendar-nav" bindtap="nextMonth">›</view>
      </view>

      <!-- 星期行 -->
      <view class="calendar-weekdays">
        <text class="weekday">日</text>
        <text class="weekday">一</text>
        <text class="weekday">二</text>
        <text class="weekday">三</text>
        <text class="weekday">四</text>
        <text class="weekday">五</text>
        <text class="weekday">六</text>
      </view>

      <!-- 日期网格 -->
      <view class="calendar-grid">
        <view
          wx:for="{{calendarDays}}"
          wx:key="dateStr"
          class="calendar-cell {{item.status}}"
          data-index="{{index}}"
          bindtap="{{item.status === 'empty' ? '' : 'selectDate'}}"
        >
          <block wx:if="{{item.status !== 'empty'}}">
            <text class="cell-day">{{item.day}}</text>
            <text class="cell-status">
              {{item.status === 'available' ? '可预约' : item.status === 'full' ? '已约滿' : item.status === 'unavailable' ? '未开放' : ''}}
            </text>
          </block>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!loading && calendarDays.length === 0}}">
      <text class="empty-text">暂无可预约日期</text>
    </view>

    <!-- 购票须知（后台可配置） -->
    <view class="notice-section" wx:if="{{ticketingNotice}}">
      <rich-text nodes="{{ticketingNotice}}"></rich-text>
    </view>
  </view>

  <!-- ===== 步骤 2: 选择场次 ===== -->
  <view class="step-content" wx:if="{{currentStep === 2}}">
    <view class="section-title">选择参观场次</view>
    <view class="selected-date-info">已选日期：{{selectedDate.date}}</view>

    <view
      class="session-card {{selectedSession && selectedSession.type === item.type ? 'selected' : ''}} {{item.remaining <= 0 ? 'full' : ''}}"
      wx:for="{{sessions}}"
      wx:key="type"
      data-index="{{index}}"
      bindtap="selectSession"
    >
      <view class="session-left">
        <view class="session-icon {{item.type === 'AM' ? 'am' : 'pm'}}">
          {{item.type === 'AM' ? '上午' : '下午'}}
        </view>
      </view>
      <view class="session-info">
        <text class="session-label">{{item.label}}</text>
        <text class="session-time">{{item.startTime}} - {{item.endTime}}</text>
        <text class="session-quota" wx:if="{{item.remaining > 0}}">剩余名额 {{item.remaining}} 位</text>
        <text class="session-quota full" wx:if="{{item.remaining <= 0}}">已约满</text>
      </view>
      <view class="session-arrow">›</view>
    </view>

    <view class="step-back" bindtap="prevStep">
      <text>‹ 返回选择日期</text>
    </view>
  </view>

  <!-- ===== 步骤 3: 填写信息 ===== -->
  <view class="step-content" wx:if="{{currentStep === 3}}">
    <view class="section-title">填写预约信息</view>
    <view class="selected-summary">
      {{selectedDate.date}} · {{selectedSession.label}} ({{selectedSession.startTime}}-{{selectedSession.endTime}})
    </view>

    <!-- 实名核验未通过警告 -->
    <view class="real-name-warning" wx:if="{{realNameBlocked}}">
      <text class="warning-icon">⚠️</text>
      <text class="warning-text">您的身份核验未通过，请先完成实名认证后再预约</text>
      <view class="warning-btn" bindtap="goToRealName">去认证</view>
    </view>

    <block wx:if="{{!realNameBlocked}}">
      <!-- 行政分区选择 -->
      <view class="form-card">
        <text class="form-card-title">行政分区</text>
        <picker mode="region" value="{{district}}" bindchange="onDistrictChange">
          <view class="picker-display">
            <text class="{{district.length > 0 ? 'has-value' : 'placeholder'}}">{{district.length > 0 ? district[0] + ' ' + district[1] + ' ' + district[2] : '请选择省/市/区'}}</text>
          </view>
        </picker>
      </view>

      <!-- 岛内/岛外选择 -->
      <view class="form-card">
        <text class="form-card-title">游客类型</text>
        <view class="radio-group">
          <view class="radio-item {{visitorType === 'ON_ISLAND' ? 'active' : ''}}" data-value="ON_ISLAND" bindtap="onVisitorTypeChange">
            <view class="radio-circle {{visitorType === 'ON_ISLAND' ? 'checked' : ''}}"></view>
            <text>岛内</text>
          </view>
          <view class="radio-item {{visitorType === 'OFF_ISLAND' ? 'active' : ''}}" data-value="OFF_ISLAND" bindtap="onVisitorTypeChange">
            <view class="radio-circle {{visitorType === 'OFF_ISLAND' ? 'checked' : ''}}"></view>
            <text>岛外</text>
          </view>
        </view>
      </view>

      <!-- 参观总人数 -->
      <view class="count-section">
        <text class="count-label">参观人数（1-5人）</text>
        <view class="count-stepper">
          <view
            class="stepper-btn {{visitorCount <= 1 ? 'disabled' : ''}}"
            data-value="{{visitorCount - 1}}"
            bindtap="onVisitorCountChange"
          >−</view>
          <text class="stepper-value">{{visitorCount}}</text>
          <view
            class="stepper-btn {{visitorCount >= 5 ? 'disabled' : ''}}"
            data-value="{{visitorCount + 1}}"
            bindtap="onVisitorCountChange"
          >+</view>
        </view>
      </view>

      <!-- 儿童人数 -->
      <view class="count-section">
        <text class="count-label">12岁以下儿童</text>
        <view class="count-stepper">
          <view
            class="stepper-btn {{childrenCount <= 0 ? 'disabled' : ''}}"
            data-value="{{childrenCount - 1}}"
            bindtap="onChildrenCountChange"
          >−</view>
          <text class="stepper-value">{{childrenCount}}</text>
          <view
            class="stepper-btn {{childrenCount >= visitorCount - 1 ? 'disabled' : ''}}"
            data-value="{{childrenCount + 1}}"
            bindtap="onChildrenCountChange"
          >+</view>
        </view>
        <text class="count-hint">至少保留1名成人陪同</text>
      </view>

      <!-- 推广邀请码 -->
      <view class="form-card">
        <text class="form-card-title">邀请码 <text style="color:#e60012">*</text></text>
        <input class="promoter-input" placeholder="请输入推广人邀请码" value="{{promoterCode}}" bindinput="onPromoterCodeInput" maxlength="8" />
        <text class="input-hint">如果没有邀请码请联系您的推荐人，如果没有推荐人请</text><text class="link-btn" bindtap="showInviteContact">点击这里</text><text class="input-hint">联系</text>
      </view>
    </block>

    <view class="step-back" bindtap="prevStep">
      <text>‹ 返回选择场次</text>
    </view>

    <button
      class="btn-primary submit-btn"
      loading="{{submitting}}"
      disabled="{{submitting || realNameBlocked}}"
      bindtap="submit"
    >提交预约</button>
  </view>

  </view>

  <!-- 邀请码联系弹窗 -->
  <view class="notice-mask" wx:if="{{showInvitePopup}}" bindtap="closeInvitePopup"></view>
  <view class="notice-popup" wx:if="{{showInvitePopup}}">
    <view class="notice-popup-header">
      <text class="notice-popup-title">{{invitePopupTitle}}</text>
    </view>
    <scroll-view class="notice-popup-body" scroll-y>
      <rich-text nodes="{{invitePopupContent}}"></rich-text>
    </scroll-view>
    <view class="notice-popup-footer">
      <button class="btn-primary notice-btn" bindtap="closeInvitePopup">关闭</button>
    </view>
  </view>
</view>
