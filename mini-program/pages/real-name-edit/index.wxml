<view class="container">
  <view class="page-title">{{isEdit ? '编辑实名信息' : '添加实名信息'}}</view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 表单 -->
  <view wx:else class="form">
    <!-- 姓名 -->
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input
        class="form-input"
        placeholder="请输入姓名"
        value="{{name}}"
        bindinput="onNameInput"
        maxlength="20"
      />
    </view>

    <!-- 证件类型 -->
    <view class="form-item">
      <text class="form-label">证件类型</text>
      <picker
        mode="selector"
        range="{{idCardTypes}}"
        range-key="label"
        value="{{idCardTypeIndex}}"
        bindchange="onIdCardTypeChange"
      >
        <view class="picker-value">
          {{idCardTypes[idCardTypeIndex].label}}
        </view>
      </picker>
    </view>

    <!-- 证件号码 -->
    <view class="form-item">
      <text class="form-label">证件号码</text>
      <input
        class="form-input"
        placeholder="{{idCardType === 'ID_CARD' ? '请输入18位身份证号' : '请输入证件号码'}}"
        value="{{idCard}}"
        bindinput="onIdCardInput"
        maxlength="{{idCardType === 'ID_CARD' ? 18 : 30}}"
      />
      <view wx:if="{{idCardType === 'ID_CARD'}}" class="ocr-btn" bindtap="idCardOCR">
        <text>扫描</text>
      </view>
    </view>

    <!-- 核验按钮 -->
    <button
      class="verify-btn"
      loading="{{verifying}}"
      disabled="{{verifying || !name.trim() || !idCard.trim()}}"
      bindtap="idCardVerify"
    >
      {{verifying ? '核验中...' : '姓名+身份证核验'}}
    </button>

    <!-- 核验结果提示 -->
    <view wx:if="{{verifyMsg}}" class="verify-result {{verifyPass ? 'verify-pass' : 'verify-fail'}}">
      <text>{{verifyMsg}}</text>
    </view>

    <!-- 提交按钮 -->
    <button
      class="submit-btn"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="submit"
    >
      {{submitting ? '保存中...' : '保存'}}
    </button>
  </view>
</view>
