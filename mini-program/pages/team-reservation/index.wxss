@charset "UTF-8";
/* 团队预约 - 表单样式 */
.container {
  min-height: 100vh;
  padding-bottom: 40px;
}

/* ===== 提示条 ===== */
.notice-bar {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin: 0 16px 12px;
  padding: 10px 12px;
  background: #fff8e1;
  border-radius: 8px;
  border-left: 3px solid #ffd700;
}

.notice-icon {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #ffd700;
  color: #fff;
  font-size: 12px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 1px;
}

.notice-text {
  font-size: 12px;
  color: #8d6e00;
  line-height: 1.5;
}

/* ===== 步骤指示器 ===== */
.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px 16px;
  background: #fff;
  margin-bottom: 12px;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}

.step-circle {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #e0e0e0;
  color: #fff;
  font-size: 13px;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-circle.active {
  background: #e60012;
}

.step-label {
  font-size: 12px;
  color: #999;
  white-space: nowrap;
}
.step-item.active .step-label {
  color: #000000;
  font-weight: bold;
}

.step-line {
  width: 40px;
  height: 2px;
  background: #e0e0e0;
  margin: 0 8px;
  margin-bottom: 22px;
}
.step-line.active {
  background: #e60012;
}

/* ===== 步骤内容 ===== */
.step-content {
  padding: 0 16px;
}

.selected-date-info,
.selected-summary {
  font-size: 13px;
  color: #005bac;
  margin-bottom: 16px;
  padding: 8px 12px;
  background: #f0f6ff;
  border-radius: 6px;
}

/* ===== 页面标题 ===== */
.section-title {
  font-size: 16px;
  font-weight: bold;
  color: #000000;
  margin: 16px 0 12px;
  padding-left: 8px;
  border-left: 3px solid #ffd700;
}

/* ===== 日历卡片 ===== */
.calendar-card {
  background: #fff;
  border-radius: 14px;
  padding: 16px 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.calendar-month {
  font-size: 16px;
  font-weight: bold;
  color: #000000;
}

.calendar-nav {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  color: #005bac;
  border-radius: 50%;
}
.calendar-nav:active {
  background: #f0f0f0;
}

.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 8px;
}

.weekday {
  text-align: center;
  font-size: 12px;
  color: #999;
  padding: 4px 0;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 2px;
}

.calendar-cell {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  font-size: 12px;
  min-height: 52px;
  padding: 4px 0;
}
.calendar-cell:active {
  opacity: 0.7;
}
.calendar-cell.available {
  background: #f0f9f0;
  color: #2e7d32;
}
.calendar-cell.available .cell-status {
  color: #4caf50;
}
.calendar-cell.unavailable {
  background: #f5f5f5;
  color: #bbb;
}
.calendar-cell.unavailable .cell-status {
  color: #ccc;
  font-size: 9px;
}
.calendar-cell.full {
  background: #fff8e1;
  color: #999;
}
.calendar-cell.full .cell-status {
  color: #f5a623;
  font-size: 9px;
}
.calendar-cell.closed {
  background: #f5f5f5;
  color: #bbb;
}
.calendar-cell.closed .cell-status {
  color: #ccc;
  font-size: 9px;
}
.calendar-cell.empty {
  background: transparent;
}

.cell-day {
  font-size: 15px;
  font-weight: bold;
  line-height: 1.3;
}

.cell-status {
  font-size: 9px;
  line-height: 1.2;
}

/* ===== 场次卡片 ===== */
.session-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  border: 2px solid transparent;
}
.session-card.selected {
  border-color: #e60012;
  background: #fff5f5;
}
.session-card:active {
  opacity: 0.7;
}

.session-left {
  margin-right: 14px;
}

.session-icon {
  width: 52px;
  height: 52px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: bold;
  color: #fff;
}
.session-icon.am {
  background: #ffd700;
  color: #000000;
}
.session-icon.pm {
  background: #005bac;
}

.session-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.session-label {
  font-size: 15px;
  font-weight: bold;
  color: #000000;
}

.session-time {
  font-size: 12px;
  color: #999;
}

.session-quota {
  font-size: 12px;
  color: #005bac;
}

.session-arrow {
  font-size: 22px;
  color: #ccc;
  padding-left: 8px;
}

/* ===== 步骤返回 ===== */
.step-back {
  padding: 12px 0;
  text-align: center;
}
.step-back text {
  font-size: 13px;
  color: #005bac;
}

/* ===== 表单区域 ===== */
.form-section {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 15px;
  font-weight: bold;
  color: #000000;
  margin-bottom: 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid #f0f0f0;
}

.form-group {
  margin-bottom: 14px;
}
.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 13px;
  color: #666;
  margin-bottom: 6px;
}

.required {
  color: #e60012;
}

.form-input {
  width: 100%;
  height: 40px;
  border: 1px solid #e8e8e8;
  border-radius: 6px;
  padding: 0 12px;
  font-size: 14px;
  color: #333;
  background: #fafafa;
  box-sizing: border-box;
}

/* 固定人数显示（团队预约固定10人） */
.count-display {
  display: flex;
  align-items: baseline;
  gap: 4px;
  padding: 8px 0;
}

.count-number {
  font-size: 28px;
  font-weight: bold;
  color: #e60012;
}

.count-unit {
  font-size: 16px;
  color: #333;
}

.count-tip {
  display: block;
  font-size: 12px;
  color: #999;
  margin-top: 2px;
}

.picker-display {
  width: 100%;
  height: 40px;
  border: 1px solid #e8e8e8;
  border-radius: 6px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fafafa;
  font-size: 14px;
  color: #333;
  box-sizing: border-box;
}

.picker-arrow {
  font-size: 18px;
  color: #ccc;
}

/* ===== 模板下载 ===== */
.template-download {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  background: #f8f9ff;
  border-radius: 8px;
  border: 1px dashed #005bac;
  cursor: pointer;
}

.template-download:active {
  opacity: 0.7;
}

.template-icon {
  width: 44px;
  height: 44px;
  border-radius: 6px;
  background: #e8f0fe;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.template-icon-text {
  font-size: 11px;
  font-weight: bold;
  color: #005bac;
}

.template-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.template-name {
  font-size: 14px;
  font-weight: bold;
  color: #000000;
}

.template-desc {
  font-size: 12px;
  color: #999;
}

.template-arrow {
  font-size: 20px;
  color: #005bac;
  font-weight: bold;
  padding: 0 4px;
}

/* ===== 人数限制提示 ===== */
.count-limit {
  display: block;
  font-size: 11px;
  color: #005bac;
  margin-top: 4px;
}

/* ===== 附件上传 ===== */
.file-upload-area {
  background: #fafafa;
  border-radius: 8px;
  padding: 12px;
  border: 1px dashed #ddd;
}

.file-list {
  margin-bottom: 10px;
}

.file-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 12px;
  background: #fff;
  border-radius: 6px;
  margin-bottom: 6px;
  border: 1px solid #eee;
}

.file-name {
  font-size: 13px;
  color: #333;
}

.file-remove {
  font-size: 12px;
  color: #e60012;
  padding: 2px 8px;
}

.file-upload-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 14px;
  border: 1px dashed #ccc;
  border-radius: 8px;
  background: #fff;
  cursor: pointer;
}

.file-upload-btn:active {
  opacity: 0.7;
}

.file-upload-icon {
  font-size: 20px;
  color: #005bac;
  font-weight: bold;
}

.file-upload-text {
  font-size: 14px;
  color: #005bac;
}

.file-upload-hint {
  display: block;
  font-size: 11px;
  color: #999;
  margin-top: 6px;
  text-align: center;
}

/* ===== 预约须知弹窗 ===== */
.notice-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.notice-popup {
  position: fixed;
  top: 50%;
  left: 16px;
  right: 16px;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 16px;
  z-index: 201;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.15);
}

.notice-popup-header {
  padding: 20px 20px 12px;
  text-align: center;
  border-bottom: 1px solid #f0f0f0;
}

.notice-popup-title {
  font-size: 18px;
  font-weight: bold;
  color: #000000;
}

.notice-popup-body {
  padding: 16px 20px;
  flex: 1;
  overflow-y: auto;
  font-size: 14px;
  color: #333;
  line-height: 1.7;
  max-height: 50vh;
  word-break: break-all;
  overflow-wrap: break-word;
}

.notice-popup-footer {
  padding: 12px 20px 20px;
  border-top: 1px solid #f0f0f0;
}

.notice-btn {
  width: 100%;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22px;
}

/* ===== 提交按钮 ===== */
.submit-btn {
  width: 100%;
  height: 46px;
  margin-top: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 通用 ===== */
.loading-tip {
  text-align: center;
  padding: 40px 0;
  font-size: 14px;
  color: #999;
}

.empty-state {
  text-align: center;
  padding: 40px 0;
}

.empty-text {
  font-size: 14px;
  color: #ccc;
}
