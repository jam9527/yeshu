/* 自定义 tabBar - 样式与原生 tabBar 保持一致 */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
}

.tab-bar-icon {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 4rpx;
}

.tab-bar-text {
  font-size: 20rpx;
  line-height: 1;
}
